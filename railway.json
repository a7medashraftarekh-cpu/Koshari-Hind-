{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "nixPkgs": [
            "nodejs_20",
            "npm-9_x"
          ]
        },
        "build": {
          "cmds": [
            "npm install",
            "npm run build"
          ]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "npm start"
  }
}
